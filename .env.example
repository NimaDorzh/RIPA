# Select the target provider: openai or deepseek
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash

#LLM_PROVIDER=together
#LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct-Lite
#LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Provider-specific API keys
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=

# without firewall
#INJECTION_DIRECT_MODE=true

# with firewall
INJECTION_DIRECT_MODE=false

NUM_RUNS=100

# Meta Model API (fill in after the API probe, see docs/api-notes.md)
META_API_BASE=
META_API_KEY=
META_MODEL=
# Abuse / cost protection for the public playground
RATE_PER_MIN=10
DAILY_CAP=500
