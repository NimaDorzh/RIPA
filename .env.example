# Meta Model API (docs: https://dev.meta.ai/docs/models)
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3
# muse-spark-1.3 is a reasoning model: 'minimal' keeps latency/tokens low ('none' is rejected)
META_REASONING=minimal
# cap only limits runaways; the model spends ~550-1050 reasoning tokens per step even on 'minimal'
META_MAX_TOKENS=4000
META_TIMEOUT=60
META_SEED=1

# Abuse / cost protection for the public playground
# live (non-recorded) runs are OFF by default: a live episode takes about a minute and costs ~12k tokens per mode
ALLOW_LIVE=0
RATE_PER_MIN=10
PER_IP_DAILY=10
DAILY_CAP=100
MAX_CONCURRENT=4
LIVE_MAX_SECONDS=25
# set to 1 on Heroku (uses the last X-Forwarded-For entry as the client address)
TRUST_PROXY=0
